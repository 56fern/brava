{
  "name": "@brava/desktop",
  "private": true,
  "version": "0.51.0",
  "description": "Brava product monitor and checkout companion",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/build.mjs",
    "package": "pnpm build && node scripts/verify-main-bundle.mjs && electron-builder --win nsis --config.directories.output=release-staging && node scripts/smoke-launch.mjs release-staging/win-unpacked/Brava.exe",
    "verify:bundle": "node scripts/verify-main-bundle.mjs",
    "smoke:launch": "node scripts/smoke-launch.mjs",
    "update:publish-local": "node scripts/publish-update-feed.mjs release-staging release",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.brava.companion",
    "productName": "Brava",
    "directories": { "output": "release-staging" },
    "files": ["dist/**/*", "build/icon-large-v3.png", "build/webhook-avatar.png", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon-large-v3.ico", "artifactName": "Brava-Setup-${version}.${ext}" },
    "nsis": { "guid": "81169a3c-9121-528c-b758-c234fcbfbc33", "oneClick": false, "allowToChangeInstallationDirectory": true, "uninstallDisplayName": "Brava" },
    "publish": [{ "provider": "generic", "url": "http://127.0.0.1:4310/updates" }]
  }
}
